# ==============================================================================
# University Management System — Environment Configuration Template
# Copy this file to '.env' and update sensitive values before starting the app.
# ==============================================================================

# Application Port
APP_PORT=8080

# Database Configuration (for standalone run against local MySQL or docker-compose)
DB_URL=jdbc:mysql://localhost:3306/university_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=rootpassword

# MySQL Container Settings (used by docker compose)
MYSQL_DATABASE=university_db
MYSQL_USER=dbuser
MYSQL_PASSWORD=dbpassword
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Security & JWT Configuration
# MUST be a 256-bit (minimum 32 bytes) hex-encoded secret key in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000              # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days in milliseconds

# Initial System Administrator Bootstrap
# When ADMIN_BOOTSTRAP_ENABLED=true and no admin accounts exist in the DB,
# DataInitializer creates an initial admin using these credentials.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@university.edu
ADMIN_BOOTSTRAP_PASSWORD=Admin@123456
ADMIN_BOOTSTRAP_FULLNAME=System Administrator
